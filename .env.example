POSTGRES_USER=support
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=support
PORT=8080
METRICS_PORT=9090
LOG_LEVEL=info
DB_POOL_SIZE=20
QUERY_TIMEOUT=5s
SHUTDOWN_TIMEOUT=15s
SESSION_DURATION=24h
SECURE_COOKIE=false
OPERATOR_INVITE_CODE=replace-with-a-private-invitation-code
# For local commands (Compose supplies its own internal database URL):
DATABASE_URL=postgres://support:replace-with-a-long-random-password@localhost:5432/support?sslmode=disable
