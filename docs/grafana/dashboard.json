        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * avg_over_time(((((((sum(increase(support_tickets_opened_total{job=\"support-desk\"}[5m])) / sum(increase(support_ticket_open_attempts_total{job=\"support-desk\"}[5m]))) and (sum(increase(support_ticket_open_attempts_total{job=\"support-desk\"}[5m])) > 0)) or vector(0)) >= bool 0.99) * ((((sum(increase(support_comments_added_total{job=\"support-desk\"}[5m])) / sum(increase(support_comment_add_attempts_total{job=\"support-desk\"}[5m]))) and (sum(increase(support_comment_add_attempts_total{job=\"support-desk\"}[5m])) > 0)) or vector(0)) >= bool 0.99) * ((((sum(increase(support_ticket_actions_total{job=\"support-desk\"}[5m])) / sum(increase(support_ticket_action_attempts_total{job=\"support-desk\"}[5m]))) and (sum(increase(support_ticket_action_attempts_total{job=\"support-desk\"}[5m])) > 0)) or vector(0)) >= bool 0.99) * ((histogram_quantile(0.95, sum by (le) (rate(support_probe_duration_seconds_bucket{job=\"slo-prober\"}[5m])))) < bool 1) * (max(up{job=\"slo-prober\"}) == bool 1) * (max(up{job=\"support-desk\"}) == bool 1) * ((time() - max(support_probe_last_round_timestamp_seconds{job=\"slo-prober\"})) < bool 45) * (min(support_probe_success{job=\"slo-prober\"}) == bool 1) * (count(support_probe_success{job=\"slo-prober\"}) == bool 3)) or vector(0))[30m:15s])",
          "instant": false,
          "legendFormat": "SLA",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Combined SLA · rolling 30m",
      "type": "stat"
    },
